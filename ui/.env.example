# Kubernetes API server connection (used server-side by Remix loaders)
# Option 1: Explicit credentials
CERTIFICATES_API_SERVER_URL=https://your-api-server:6443
CERTIFICATES_API_CA_FILE=/path/to/ca.crt
CERTIFICATES_API_TOKEN_FILE=/path/to/token

# Option 1b: Client certificate auth (used when token file is not set)
CERTIFICATES_API_CERT_FILE=/path/to/client.crt
CERTIFICATES_API_KEY_FILE=/path/to/client.key

# Option 2: Use local kubeconfig (development)
# Defaults to .test-infra/kubeconfig if not set
# (no env var needed — falls back automatically when CERTIFICATES_API_SERVER_URL is unset)
